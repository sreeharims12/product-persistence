DATABASE_URL=postgresql://postgres:123456@localhost:5432/product_monitoring
SECRET_KEY=super-secret-jwt-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

